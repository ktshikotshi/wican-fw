+        if ((ep_desc->bEndpointAddress & 0x80) && ((ep_desc->bmAttributes & 0x03) == 0x03)) {
+            USBH_EP_INIT(rndis_class->intin, ep_desc);
+            break;
+        }
+    }
 
     for (uint8_t i = 0; i < hport->config.intf[intf + 1].altsetting[0].intf_desc.bNumEndpoints; i++) {
         ep_desc = &hport->config.intf[intf + 1].altsetting[0].ep[i].ep_desc;
@@ -495,9 +517,9 @@ static int usbh_rndis_disconnect(struct usbh_hubport *hport, uint8_t intf)
             usbh_kill_urb(&rndis_class->bulkout_urb);
         }
 
-        // if (rndis_class->intin) {
