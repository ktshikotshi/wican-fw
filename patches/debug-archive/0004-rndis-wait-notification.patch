+/* fork: wait for RESPONSE_AVAILABLE on the control interface's interrupt
+ * endpoint before GET_ENCAPSULATED_RESPONSE, as the RNDIS spec and Linux
+ * do. Alcatel IK40 NAKs a response read issued before it signals, and a
+ * read that timed out leaves it STALLing the next one (-USB_ERR_STALL).
+ * Bounded wait; no endpoint or no notification falls through to the
+ * plain read as before. */
+#define RNDIS_NOTIFY_TIMEOUT_MS 1000
 static int usbh_rndis_get_notification(struct usbh_rndis *rndis_class)
 {
-    (void)rndis_class;
-    // int ret;
-    // struct usbh_urb *urb = &rndis_class->intin_urb;
-
-    // usbh_int_urb_fill(urb, rndis_class->hport, rndis_class->intin, g_rndis_inttx_buffer, rndis_class->intin->wMaxPacketSize, USB_OSAL_WAITING_FOREVER, NULL, NULL);
-    // ret = usbh_submit_urb(urb);
-    // if (ret == 0) {
-    //     ret = urb->actual_length;
-    // }
-    // return ret;
-    return 0;
+    int ret;
+    struct usbh_urb *urb = &rndis_class->intin_urb;
+
+    if (rndis_class->intin == NULL) {
+        return 0;
+    }
+    uint32_t len = (uint32_t)USB_GET_MAXPACKETSIZE(rndis_class->intin->wMaxPacketSize);
+    if (len > (uint32_t)sizeof(g_rndis_inttx_buffer)) {
+        len = (uint32_t)sizeof(g_rndis_inttx_buffer);
+    }
+    usbh_int_urb_fill(urb, rndis_class->hport, rndis_class->intin, g_rndis_inttx_buffer,
+                      len, RNDIS_NOTIFY_TIMEOUT_MS, NULL, NULL);
+    ret = usbh_submit_urb(urb);
+    if (ret == 0) {
+        ret = urb->actual_length;
+    } else {
+        USB_LOG_WRN("rndis no RESPONSE_AVAILABLE notification (%d), reading anyway\r\n", ret);
+    }
+    return ret;
 }
 
 static int usbh_rndis_init_msg_transfer(struct usbh_rndis *rndis_class)
@@ -343,8 +358,15 @@ static int usbh_rndis_connect(struct usbh_hubport *hport, uint8_t intf)
     hport->config.intf[intf].priv = rndis_class;
     hport->config.intf[intf + 1].priv = NULL;
 
-    // ep_desc = &hport->config.intf[intf].altsetting[0].ep[0].ep_desc;
