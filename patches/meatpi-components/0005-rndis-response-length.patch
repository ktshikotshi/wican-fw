         setup->wValue = 0;
         setup->wIndex = 0;
-        setup->wLength = sizeof(g_rndis_buf);
+        /* fork: g_rndis_buf is a pointer in this tree (shared eth pool),
+         * so sizeof() gave wLength = 4 and every response was cut to 4
+         * bytes; the stick then times out / STALLs the next read. */
+        setup->wLength = USBH_ETH_SHARED_CTRL_SIZE;
 
         ret = usbh_control_transfer(rndis_class->hport, setup, resp);
         if (ret != -USB_ERR_TIMEOUT) {
@@ -168,6 +171,7 @@ static int usbh_rndis_init_msg_transfer(struct usbh_rndis *rndis_class)
     return ret;
 }
 
+/* fork: *info_len is in/out: buffer size in, bytes copied out */
 int usbh_rndis_query_msg_transfer(struct usbh_rndis *rndis_class, uint32_t oid, uint32_t query_len, uint8_t *info, uint32_t *info_len)
 {
     struct usb_setup_packet *setup;
