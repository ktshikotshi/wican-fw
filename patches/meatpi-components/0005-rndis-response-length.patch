                     /* fork: optional OID, some sticks (Alcatel IK40) refuse it */
                     USB_LOG_WRN("rndis query OID_GEN_MEDIA_CONNECT_STATUS failed (%d), continuing\r\n", ret);
@@ -439,7 +453,7 @@ static int usbh_rndis_connect(struct usbh_hubport *hport, uint8_t intf)
                 }
                 break;
