                     /* fork: optional OID, some sticks (Alcatel IK40) refuse it */
                     USB_LOG_WRN("rndis query OID_802_3_MAXIMUM_LIST_SIZE failed (%d), continuing\r\n", ret);
@@ -448,7 +462,7 @@ static int usbh_rndis_connect(struct usbh_hubport *hport, uint8_t intf)
                 }
