@@ -12,7 +12,19 @@
 
 /* ================ USB common Configuration ================ */
 
-#define CONFIG_USB_PRINTF(...) esp_rom_printf(__VA_ARGS__)
+/* fork: route CherryUSB logs through esp_log so the web UI log (and its
+ * file/ws sinks) shows enumeration and class-driver errors; esp_rom_printf
+ * only reached the UART, which a USB-host user cannot watch. */
+#include "esp_log.h"
+#include "freertos/FreeRTOS.h"
+#define CONFIG_USB_PRINTF(...)                                         \
+    do {                                                               \
+        if (xPortInIsrContext()) {                                     \
+            esp_rom_printf(__VA_ARGS__);                               \
+        } else {                                                       \
+            esp_log_write(ESP_LOG_INFO, "cherryusb", __VA_ARGS__);     \
+        }                                                              \
+    } while (0)
 
